# MongoDB connection string (Atlas or self-hosted). Use a dedicated database for Vecta -
# do not point this at another application's database.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vecta?retryWrites=true&w=majority

# Long, random secret used to sign auth JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
